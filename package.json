{
  "name": "pdf-ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-pdfjs-assets.mjs && vp dev",
    "build": "node scripts/sync-pdfjs-assets.mjs && vue-tsc -b && vp build",
    "preview": "vp preview",
    "sync:pdfjs": "node scripts/sync-pdfjs-assets.mjs",
    "verify:geometry": "vp test --project geometry",
    "test:acceptance": "vp test --project acceptance",
    "fixtures:make": "node tests/fixtures/make-fixtures.mjs && node tests/fixtures/make-heavy-text.mjs && node tests/fixtures/make-dot.mjs",
    "postinstall": "node scripts/sync-pdfjs-assets.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "signature_pad": "^5.1.4",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  }
}
